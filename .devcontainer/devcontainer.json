{
  "name": "Google QUEST",
  "build": {"dockerfile": "../docker/Dockerfile", "context": "..", "target": "lab"},
  "overrideCommand": true,
  "remoteUser": "researcher",
  "containerEnv": {"QUEST_DATA_DIR": "/data", "TOKENIZERS_PARALLELISM": "false"},
  "mounts": ["source=${localEnv:QUEST_DATA_DIR},target=/data,type=bind,readonly"],
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-toolsai.jupyter"]}}
}
